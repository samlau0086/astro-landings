---
import '../styles/global.css';

const whatsappUrl = 'https://wa.me/85265426672';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const offers = [
  {
    title: 'Wholesale & Retail',
    description: 'Flexible ordering for individual buyers, boutiques, resellers, and growing wholesale businesses.',
    icon: '01',
  },
  {
    title: 'Secure PayPal Payment',
    description: 'Pay through a secure PayPal payment link after every product and order detail is confirmed.',
    icon: '02',
  },
  {
    title: 'Inspection Before Shipping',
    description: 'Receive clear photos and a high-definition video to inspect your item before shipment.',
    icon: '03',
  },
  {
    title: 'Fast Worldwide Delivery',
    description: 'FedEx or UPS delivery with full tracking and personal follow-up for high-value packages.',
    icon: '04',
  },
];

const reasons = [
  'Master-grade bags for both wholesale and retail orders',
  'Secure PayPal payment link after order confirmation',
  'Photo and HD video inspection before shipment',
  'Free replacement or refund before shipping if the item is not approved',
  'FedEx or UPS worldwide delivery with complete tracking',
  'Personal logistics follow-up for high-value packages',
];

const steps = [
  ['01', 'Add Us on WhatsApp', 'Get the latest catalog plus an exclusive $20 discount for new customers.'],
  ['02', 'Choose Your Products', 'Browse the catalog or send us photos of the items you want. We will check stock and quote our best price.'],
  ['03', 'Confirm & Pay Securely', 'Confirm the product, quantity, price, color, size, and shipping details, then pay through a secure PayPal link.'],
  ['04', 'Order Preparation', 'We normally prepare your order within 1-3 working days after payment.'],
  ['05', 'Inspect Before Shipping', 'We send a high-definition product video. Request a replacement or refund if you are not satisfied.'],
  ['06', 'Worldwide Delivery', 'After your confirmation, we ship from China by FedEx or UPS. Estimated delivery is 7-14 working days.'],
  ['07', 'Tracking & After-Sales', 'Receive full tracking, personal logistics follow-up, and support for major quality issues reported within 48 hours.'],
];

const serviceHighlights = [
  {
    title: 'Top Master Grade Authentic Quality',
    icon: '✅',
    accent: '💕',
    src: '/cart.jpg',
    alt: 'Master-grade bag selection showing product quality',
  },
  {
    title: 'Premium Customer Service',
    icon: '💯',
    accent: '🛍️',
    src: '/showcase.jpg',
    alt: 'Bag catalog selection supported by premium customer service',
  },
  {
    title: 'Fast Worldwide Delivery',
    icon: '✈️',
    accent: '✨',
    src: '/unbox.jpg',
    alt: 'Product selection available for fast worldwide delivery',
  },
  {
    title: 'Safe PayPal Payment Guarantee',
    icon: '🏦',
    accent: '💵',
    src: '/packging.jpg',
    alt: 'Master-grade products available with secure PayPal payment',
  },
];

const reviews = [
  {
    quote: 'Everything was transparent from the inspection video to delivery. I love my bag.',
    author: 'M****',
    role: 'From United States',
    initials: 'M',
    productImages: [{ src: '/reviews/1.jpg', alt: 'Customer review screenshot 1' }],
  },
  {
    quote: 'The quality is beautiful and the communication was excellent throughout the order.',
    author: 'A****',
    role: 'From United States',
    initials: 'A',
    productImages: [{ src: '/reviews/2.jpg', alt: 'Customer review screenshot 2' }],
  },
  {
    quote: 'The video inspection gave me confidence, and the package arrived safely and quickly.',
    author: 'J****',
    role: 'From United States',
    initials: 'J',
    productImages: [{ src: '/reviews/3.jpg', alt: 'Customer review screenshot 3' }],
  },
  {
    quote: 'The details look amazing in person. I am already choosing my next order.',
    author: 'S****',
    role: 'From United States',
    initials: 'S',
    productImages: [{ src: '/reviews/4.jpg', alt: 'Customer review screenshot 4' }],
  },
  {
    quote: 'Fast replies, careful packaging, and exactly the quality shown in the inspection video.',
    author: 'E****',
    role: 'From United States',
    initials: 'E',
    productImages: [{ src: '/reviews/5.jpg', alt: 'Customer review screenshot 5' }],
  },
  {
    quote: 'A smooth experience from payment to delivery. The bag exceeded my expectations.',
    author: 'C****',
    role: 'From United States',
    initials: 'C',
    productImages: [{ src: '/reviews/6.jpg', alt: 'Customer review screenshot 6' }],
  },
  {
    quote: 'The customer service was patient and helpful, and every detail was confirmed before shipping.',
    author: 'L****',
    role: 'From United States',
    initials: 'L',
    productImages: [{ src: '/reviews/7.jpg', alt: 'Customer review screenshot 7' }],
  },
  {
    quote: 'Excellent quality and reliable tracking. My order arrived in perfect condition.',
    author: 'N****',
    role: 'From United States',
    initials: 'N',
    productImages: [{ src: '/reviews/8.jpg', alt: 'Customer review screenshot 8' }],
  },
  {
    quote: 'I appreciated seeing the product before shipment. The whole process felt secure and professional.',
    author: 'R****',
    role: 'From United States',
    initials: 'R',
    productImages: [{ src: '/reviews/9.jpg', alt: 'Customer review screenshot 9' }],
  },
];

const policies = [
  ['Approve Before We Ship', 'We send a detailed video before shipment. If you are not satisfied, you may request a replacement, cancel the order, or request a refund before dispatch. PayPal deducts a 4.5% refund processing fee directly; this fee is not charged by us.'],
  ['Major Quality Issues', 'Please record an unboxing video. If the item has a major issue such as a broken zipper, damaged hardware, or damaged leather, send clear photos or videos within 48 hours after delivery. We will arrange a refund or resend promptly, and the damaged item does not need to be returned.'],
  ['Handmade Details', 'Minor handmade details, including slight glazing dents, stitching irregularities, or small imperfections identified during quality control, are not considered defects. We may offer a store coupon as compensation when appropriate.'],
  ['Backside Strap Stitching', 'Backside strap stitching is not considered a flaw and is not eligible for return, exchange, or refund. We ensure that the front-side stitching meets our quality standard before shipment.'],
  ['Customized Items', 'Hot-stamped or personalized items are non-refundable, non-returnable, and non-exchangeable. Please confirm every customization detail carefully before production.'],
  ['Packaging, Color & Size', 'Gift box damage caused during transit does not qualify for compensation, although we use thick outer cartons for protection. Please confirm color and size before shipment; natural-light photos or videos are available on request.'],
  ['Non-Quality Issues', 'Refunds and exchanges are not available for non-quality reasons such as color preference, size selection, or a change of mind after shipment. Please confirm all details carefully before approving dispatch.'],
];

const faqs = [
  ['Do you accept both wholesale and retail orders?', 'Yes. We support individual retail orders as well as volume orders for boutiques, resellers, and wholesale buyers.'],
  ['How can I see the catalog and prices?', 'Add us on WhatsApp to receive the latest catalog, current pricing, stock information, and your new-customer discount.'],
  ['How do I pay?', 'After all order details are confirmed, we send you a secure PayPal payment link.'],
  ['How long does order preparation take?', 'Order preparation normally takes 1-3 working days before dispatch. Customized or large wholesale orders may require additional time.'],
  ['Can I inspect my item before it ships?', 'Yes. We send clear photos or a high-definition product video and ship only after you approve the item.'],
  ['How long does delivery take?', 'Estimated delivery is 7-14 working days after dispatch via FedEx or UPS. Timing may vary by destination and customs processing.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="MAESVANTI master-grade bags for wholesale and retail, with secure PayPal payment, pre-shipment video inspection, and worldwide delivery."
    />
    <title>MAESVANTI | Master-Grade Bags Wholesale & Retail</title>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="site-logo" href="#top" aria-label="Go to homepage">
        <span>MA</span>
        <strong>MAESVANTI</strong>
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation">
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="sr-only">Toggle navigation menu</span>
      </button>
      <nav class="site-nav" id="site-navigation" aria-label="Page sections">
        <a href="#offer">Why Us</a>
        <a href="#promotion">Promotion</a>
        <a href="#process">How to Order</a>
        <a href="#shipping">Shipping</a>
        <a href="#reviews">Reviews</a>
        <a href="#policy">Return Policy</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero section-shell" id="top">
        <div class="hero__content">
          <p class="eyebrow">Master-Grade Bags | Wholesale + Retail</p>
          <h1>Master-Grade Bags, Inspected Before They Ship.</h1>
          <p class="hero__lead">
            Shop confidently with secure PayPal payments, detailed photo and video quality inspection,
            and fast worldwide delivery by FedEx or UPS.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a class="button button--primary" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_catalog_hero">
              <svg class="whatsapp-cta__icon" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M16 3.25A12.6 12.6 0 0 0 5.28 22.47L3.6 28.75l6.43-1.64A12.62 12.62 0 1 0 16 3.25Z" />
                <path d="M12.2 9.3c-.27-.6-.55-.61-.81-.62h-.69c-.24 0-.63.09-.96.45-.33.36-1.26 1.23-1.26 3s1.29 3.48 1.47 3.72c.18.24 2.53 4.04 6.26 5.5 3.1 1.22 3.73.98 4.4.92.67-.06 2.16-.88 2.46-1.74.3-.86.3-1.6.21-1.75-.09-.15-.33-.24-.69-.42-.36-.18-2.16-1.07-2.49-1.19-.33-.12-.57-.18-.81.18-.24.36-.93 1.19-1.14 1.43-.21.24-.42.27-.78.09-.36-.18-1.52-.56-2.9-1.79-1.07-.95-1.8-2.13-2.01-2.49-.21-.36-.02-.55.16-.73.16-.16.36-.42.54-.63.18-.21.24-.36.36-.6.12-.24.06-.45-.03-.63-.09-.18-.79-1.97-1.29-3.4Z" />
              </svg>
              <span>Get Catalog &amp; $20 Discount</span>
            </a>
            <a class="button button--secondary" href="#process">See How to Order</a>
          </div>
        </div>
        <div class="hero__aside">
          <div class="hero-card" aria-label="Pre-shipment approval process">
            <div class="hero-card__badge">Your Approval Comes First</div>
            <div class="approval-steps">
              <div><span>01</span><p><strong>We prepare your item</strong><small>Usually within 1-3 working days</small></p></div>
              <div><span>02</span><p><strong>You inspect every detail</strong><small>Clear photos and HD product video</small></p></div>
              <div><span>03</span><p><strong>We ship after confirmation</strong><small>FedEx or UPS with full tracking</small></p></div>
            </div>
            <div class="hero-card__footer">
              <strong>48H</strong>
              <span>After-sales reporting window for major quality issues</span>
            </div>
          </div>

          <dl class="hero__metrics" aria-label="Order and delivery highlights">
            <div>
              <dt>PayPal</dt>
              <dd>Secure payment</dd>
            </div>
            <div>
              <dt>1-3 Days</dt>
              <dd>Order preparation</dd>
            </div>
            <div>
              <dt>7-14 Days</dt>
              <dd>Estimated delivery</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="category-showcase section-shell" aria-label="Product categories">
        <h2 class="category-showcase__title">
          Master-Grade Bags, Carefully Inspected in Every Detail.
        </h2>
        <img
          class="category-showcase__image"
          src="/bags-category.png"
          alt="Available designer bag and footwear categories"
          width="1920"
          height="878"
          loading="eager"
        />
        <a class="category-showcase__cta" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_catalog_categories">
          <svg class="whatsapp-cta__icon category-showcase__cta-icon" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 3.25A12.6 12.6 0 0 0 5.28 22.47L3.6 28.75l6.43-1.64A12.62 12.62 0 1 0 16 3.25Z" />
            <path d="M12.2 9.3c-.27-.6-.55-.61-.81-.62h-.69c-.24 0-.63.09-.96.45-.33.36-1.26 1.23-1.26 3s1.29 3.48 1.47 3.72c.18.24 2.53 4.04 6.26 5.5 3.1 1.22 3.73.98 4.4.92.67-.06 2.16-.88 2.46-1.74.3-.86.3-1.6.21-1.75-.09-.15-.33-.24-.69-.42-.36-.18-2.16-1.07-2.49-1.19-.33-.12-.57-.18-.81.18-.24.36-.93 1.19-1.14 1.43-.21.24-.42.27-.78.09-.36-.18-1.52-.56-2.9-1.79-1.07-.95-1.8-2.13-2.01-2.49-.21-.36-.02-.55.16-.73.16-.16.36-.42.54-.63.18-.21.24-.36.36-.6.12-.24.06-.45-.03-.63-.09-.18-.79-1.97-1.29-3.4Z" />
          </svg>
          <span>Contact Us for Catalog &amp; Price Details</span>
        </a>
      </section>

      <section class="trust-bar" id="trust" aria-label="Social proof and trust bar">
        <p>A clearer, safer way to order master-grade bags from anywhere in the world.</p>
        <div>
          <span>Wholesale + Retail</span>
          <span>Secure PayPal Payment</span>
          <span>Video Inspection</span>
          <span>Worldwide Tracking</span>
        </div>
      </section>

      <section class="section-shell feature-carousel-section" aria-labelledby="feature-carousel-title">
        <div class="section-heading feature-carousel-heading">
          <p class="eyebrow">Why Shop With MAESVANTI</p>
          <h2 id="feature-carousel-title">Quality, service, and delivery you can trust.</h2>
        </div>
        <div class="product-slider feature-carousel" data-product-slider tabindex="0" aria-roledescription="carousel" aria-label="MAESVANTI service highlights">
          <div class="product-slider__viewport">
            <div class="product-slider__track" data-product-track>
              {serviceHighlights.map((feature, index) => (
                <article class="product-slide feature-card" data-product-slide aria-label={`Highlight ${index + 1} of ${serviceHighlights.length}`}>
                  <button
                    class="feature-card__image"
                    type="button"
                    data-lightbox-src={feature.src}
                    data-lightbox-alt={feature.alt}
                    aria-label={`Enlarge image for ${feature.title}`}
                  >
                    <img src={feature.src} alt={feature.alt} loading="lazy" />
                    <span aria-hidden="true">↗</span>
                  </button>
                  <div class="feature-card__body">
                    <span class="feature-card__icon" aria-hidden="true">{feature.icon}</span>
                    <h3>{feature.title}</h3>
                    <span class="feature-card__accent" aria-hidden="true">{feature.accent}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="product-slider__controls">
            <div class="product-slider__dots" data-product-dots aria-label="Choose a service highlight"></div>
            <div class="product-slider__arrows">
              <button class="slider-arrow" type="button" data-product-prev aria-label="Previous highlights">←</button>
              <button class="slider-arrow" type="button" data-product-next aria-label="Next highlights">→</button>
            </div>
          </div>
        </div>
      </section>

      <section class="promo-countdown section-shell" id="promotion" aria-labelledby="promotion-title">
        <div class="promo-countdown__card">
          <div class="promo-countdown__content">
            <p class="eyebrow">New Customer Discount</p>
            <h2 id="promotion-title">Get $20 off your first order.</h2>
            <p>
              Add us on WhatsApp to receive the latest product catalog, current prices,
              and your exclusive new-customer discount.
            </p>
          </div>
        </div>
        <div class="flip-countdown" data-countdown data-duration-hours="48" aria-live="polite">
          <p>Promotion End Time</p>
          <div class="flip-countdown__row" aria-label="Promotion countdown timer">
            <div class="flip-countdown__group">
              <span>Days</span>
              <div class="flip-countdown__digits" data-unit="days">
                <strong data-digit>0</strong>
                <strong data-digit>0</strong>
              </div>
            </div>
            <b aria-hidden="true">:</b>
            <div class="flip-countdown__group">
              <span>Hours</span>
              <div class="flip-countdown__digits" data-unit="hours">
                <strong data-digit>0</strong>
                <strong data-digit>0</strong>
              </div>
            </div>
            <b aria-hidden="true">:</b>
            <div class="flip-countdown__group">
              <span>Minutes</span>
              <div class="flip-countdown__digits" data-unit="minutes">
                <strong data-digit>0</strong>
                <strong data-digit>0</strong>
              </div>
            </div>
            <b aria-hidden="true">:</b>
            <div class="flip-countdown__group">
              <span>Seconds</span>
              <div class="flip-countdown__digits" data-unit="seconds">
                <strong data-digit>0</strong>
                <strong data-digit>0</strong>
              </div>
            </div>
          </div>
        </div>
        <div class="promo-countdown__action">
          <a class="button button--primary" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_discount_promotion">
            <svg class="whatsapp-cta__icon" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M16 3.25A12.6 12.6 0 0 0 5.28 22.47L3.6 28.75l6.43-1.64A12.62 12.62 0 1 0 16 3.25Z" />
              <path d="M12.2 9.3c-.27-.6-.55-.61-.81-.62h-.69c-.24 0-.63.09-.96.45-.33.36-1.26 1.23-1.26 3s1.29 3.48 1.47 3.72c.18.24 2.53 4.04 6.26 5.5 3.1 1.22 3.73.98 4.4.92.67-.06 2.16-.88 2.46-1.74.3-.86.3-1.6.21-1.75-.09-.15-.33-.24-.69-.42-.36-.18-2.16-1.07-2.49-1.19-.33-.12-.57-.18-.81.18-.24.36-.93 1.19-1.14 1.43-.21.24-.42.27-.78.09-.36-.18-1.52-.56-2.9-1.79-1.07-.95-1.8-2.13-2.01-2.49-.21-.36-.02-.55.16-.73.16-.16.36-.42.54-.63.18-.21.24-.36.36-.6.12-.24.06-.45-.03-.63-.09-.18-.79-1.97-1.29-3.4Z" />
            </svg>
            <span>Claim My $20 Discount</span>
          </a>
        </div>
      </section>

      <section class="section-shell split-section" id="offer">
        <div class="section-heading offer-heading">
          <p class="eyebrow">What We Offer</p>
          <h2>Confidence at every step of your order.</h2>
        </div>
        <div class="card-grid">
          {offers.map((offer) => (
            <article class="info-card">
              <span>{offer.icon}</span>
              <h3>{offer.title}</h3>
              <p>{offer.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell why-section" id="why-buy">
        <div class="section-heading">
          <p class="eyebrow">Our Service Promise</p>
          <h2>See the product first. Approve it. Then we ship.</h2>
          <p>We make the process transparent for both single-item purchases and wholesale orders.</p>
        </div>
        <div class="reason-panel">
          {reasons.map((reason) => (
            <div>
              <span aria-hidden="true">✓</span>
              <p>{reason}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section-shell process-section" id="process">
        <div class="section-heading">
          <p class="eyebrow">How to Order</p>
          <h2>From WhatsApp inquiry to worldwide delivery.</h2>
          <p>A simple seven-step process with inspection and confirmation built in.</p>
        </div>
        <div class="steps">
          {steps.map(([number, title, description]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell advantage-section" id="advantages">
        <div class="advantage-card advantage-card--dark">
          <p class="eyebrow">Before Dispatch</p>
          <h2>You stay in control before your order leaves.</h2>
          <ul>
            <li>Preparation normally takes 1-3 working days</li>
            <li>Receive clear photos or a high-definition inspection video</li>
            <li>Request a replacement, cancellation, or refund before shipment</li>
            <li>Shipment is arranged only after your confirmation</li>
          </ul>
        </div>
        <div class="advantage-card">
          <p class="eyebrow">After Dispatch</p>
          <h2>Tracked delivery with personal follow-up.</h2>
          <ul>
            <li>FedEx or UPS international delivery from China</li>
            <li>Estimated arrival in 7-14 working days after dispatch</li>
            <li>Complete real-time logistics tracking information</li>
            <li>Personal follow-up for high-value packages</li>
          </ul>
        </div>
      </section>

      <section class="section-shell shipping-section" id="shipping">
        <div>
          <p class="eyebrow">Worldwide Shipping</p>
          <h2>Fast delivery, full tracking, and real support.</h2>
          <p>
            Every approved order is packed in a protective outer carton and shipped by FedEx or UPS.
            We provide the tracking number and follow the shipment through delivery, with extra attention
            for high-value packages.
          </p>
        </div>
        <div class="delivery-timeline" aria-label="Order and delivery timeline">
          <div><strong>1-3</strong><span>Working days for order preparation</span></div>
          <div><strong>7-14</strong><span>Working days estimated after dispatch</span></div>
          <div><strong>24/7</strong><span>Online logistics tracking access</span></div>
        </div>
      </section>

      <section class="section-shell review-section" id="reviews" aria-labelledby="reviews-title">
        <div class="section-heading">
          <p class="eyebrow">Customer Reviews</p>
          <h2 id="reviews-title">What buyers say after delivery.</h2>
          <p>Feedback from retail customers, boutique owners, and wholesale buyers.</p>
        </div>
        <div class="review-slider" data-review-slider tabindex="0" aria-roledescription="carousel" aria-label="Customer reviews">
          <div class="review-slider__viewport">
            <div class="review-slider__track" data-review-track>
              {reviews.map((review, index) => (
                <figure class="review-slide" data-review-slide aria-label={`Review ${index + 1} of ${reviews.length}`}>
                  <div class="review-slide__topline">
                    <div class="review-slide__rating" aria-label="5 out of 5 stars">★★★★★</div>
                    <span class="review-slide__quote-mark" aria-hidden="true">”</span>
                  </div>
                  <div class="review-gallery" aria-label={`${review.author} product review photos`}>
                    {review.productImages.map((photo, photoIndex) => (
                      <button
                        class="review-gallery__item"
                        type="button"
                        data-lightbox-src={photo.src}
                        data-lightbox-alt={photo.alt}
                        aria-label={`Open product review image ${photoIndex + 1} from ${review.author}`}
                      >
                        <img src={photo.src} alt={photo.alt} loading="lazy" />
                      </button>
                    ))}
                  </div>
                  <blockquote>“{review.quote}”</blockquote>
                  <figcaption>
                    <span class="review-slide__avatar-fallback" aria-hidden="true">{review.initials}</span>
                    <span>
                      <strong>{review.author}</strong>
                      <small>{review.role}</small>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
          <div class="review-slider__controls">
            <div class="review-slider__dots" data-review-dots aria-label="Choose a review"></div>
            <div class="review-slider__arrows">
              <button class="slider-arrow" type="button" data-review-prev aria-label="Previous review">←</button>
              <button class="slider-arrow" type="button" data-review-next aria-label="Next review">→</button>
            </div>
          </div>
        </div>
      </section>

      <div class="image-lightbox" data-lightbox hidden>
        <button class="image-lightbox__close" type="button" data-lightbox-close aria-label="Close enlarged image">×</button>
        <div class="image-lightbox__frame" role="dialog" aria-modal="true" aria-label="Enlarged gallery image">
          <img data-lightbox-image src="" alt="" />
        </div>
      </div>

      <section class="section-shell policy-section" id="policy" aria-labelledby="policy-title">
        <div class="section-heading">
          <p class="eyebrow">Return & Refund Policy</p>
          <h2 id="policy-title">Clear protection, with clear conditions.</h2>
          <p>
            Please review these terms before payment and confirm the product details carefully before shipment.
          </p>
        </div>
        <div class="policy-highlight">
          <span>48 hours</span>
          <p>Report major quality issues with clear photos or video within 48 hours after delivery.</p>
        </div>
        <div class="policy-list">
          {policies.map(([title, description], index) => (
            <details open={index === 0}>
              <summary><span>{String(index + 1).padStart(2, '0')}</span>{title}</summary>
              <p>{description}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section-shell faq-section" id="faq">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2>Everything to know before you order.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="contact-section section-shell" id="contact" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="eyebrow">Catalog, Price & Stock</p>
          <h2 id="contact-title">Start your order on WhatsApp.</h2>
          <p>Send us a product photo or tell us what you are looking for. We will reply with stock, pricing, and the latest catalog.</p>
        </div>
        <div class="contact-grid">
          <a class="contact-card" href="mailto:info@maesvantishop.site?subject=Wholesale%20%2F%20Retail%20Quote%20Request" data-analytics-event="email_wholesale_inquiry">
            <span aria-hidden="true">✉</span>
            <div>
              <strong>Wholesale Inquiry</strong>
              <p>Ask about volume pricing and availability</p>
            </div>
          </a>
          <a class="contact-card" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_catalog_contact">
            <span aria-hidden="true">☏</span>
            <div>
              <strong>WhatsApp Catalog</strong>
              <p>Get catalog, prices, stock, and $20 off</p>
            </div>
          </a>
        </div>
      </section>

      <section class="final-cta section-shell" id="final-cta">
        <p class="eyebrow">Wholesale + Retail</p>
        <h2>Choose your bag. Inspect every detail. Approve before shipping.</h2>
        <p>
          Contact us for the latest catalog, current stock, wholesale pricing, and your new-customer discount.
        </p>
        <a class="button button--primary" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_catalog_footer">
          <svg class="whatsapp-cta__icon" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 3.25A12.6 12.6 0 0 0 5.28 22.47L3.6 28.75l6.43-1.64A12.62 12.62 0 1 0 16 3.25Z" />
            <path d="M12.2 9.3c-.27-.6-.55-.61-.81-.62h-.69c-.24 0-.63.09-.96.45-.33.36-1.26 1.23-1.26 3s1.29 3.48 1.47 3.72c.18.24 2.53 4.04 6.26 5.5 3.1 1.22 3.73.98 4.4.92.67-.06 2.16-.88 2.46-1.74.3-.86.3-1.6.21-1.75-.09-.15-.33-.24-.69-.42-.36-.18-2.16-1.07-2.49-1.19-.33-.12-.57-.18-.81.18-.24.36-.93 1.19-1.14 1.43-.21.24-.42.27-.78.09-.36-.18-1.52-.56-2.9-1.79-1.07-.95-1.8-2.13-2.01-2.49-.21-.36-.02-.55.16-.73.16-.16.36-.42.54-.63.18-.21.24-.36.36-.6.12-.24.06-.45-.03-.63-.09-.18-.79-1.97-1.29-3.4Z" />
          </svg>
          <span>Get Catalog &amp; Price Details</span>
        </a>
      </section>
    </main>
  </body>
</html>

<script>
  const trackEvent = (eventName) => {
    if (typeof window.gtag !== 'function') return;
    window.gtag('event', eventName, {
      event_category: 'engagement',
      transport_type: 'beacon',
    });
  };

  document.querySelectorAll('[data-analytics-event]').forEach((element) => {
    element.addEventListener('click', () => {
      trackEvent(element.getAttribute('data-analytics-event'));
    });
  });

  const menuToggle = document.querySelector('[data-menu-toggle]');
  const siteNavigation = document.querySelector('#site-navigation');

  const closeMenu = () => {
    if (!menuToggle || !siteNavigation) return;
    menuToggle.setAttribute('aria-expanded', 'false');
    siteNavigation.classList.remove('is-open');
  };

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    siteNavigation?.classList.toggle('is-open', !isOpen);
  });

  siteNavigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
  const lightboxClose = lightbox?.querySelector('[data-lightbox-close]');

  const setupSlider = ({ rootSelector, trackSelector, slideSelector, dotsSelector, previousSelector, nextSelector, dotLabel, desktopVisible = 1, stepBySlide = false }) => {
    const root = document.querySelector(rootSelector);
    const trackElement = root?.querySelector(trackSelector);
    const slideElements = root ? Array.from(root.querySelectorAll(slideSelector)) : [];
    const dotsElement = root?.querySelector(dotsSelector);
    const previousControl = root?.querySelector(previousSelector);
    const nextControl = root?.querySelector(nextSelector);

    if (!root || !trackElement || !dotsElement || slideElements.length === 0) return;

    let currentIndex = 0;
    let touchStartX = 0;

    const getVisibleSlides = () => (window.matchMedia('(min-width: 900px)').matches ? desktopVisible : 1);
    const getMaxIndex = () => stepBySlide
      ? Math.max(0, slideElements.length - getVisibleSlides())
      : Math.max(0, Math.ceil(slideElements.length / getVisibleSlides()) - 1);
    const getTrackGap = () => {
      const styles = window.getComputedStyle(trackElement);
      return Number.parseFloat(styles.columnGap || styles.gap) || 0;
    };
    const getPageStride = () => {
      if (stepBySlide) {
        return (slideElements[0]?.getBoundingClientRect().width ?? 0) + getTrackGap();
      }
      const viewportWidth = trackElement.parentElement?.clientWidth ?? trackElement.clientWidth;
      return viewportWidth + getTrackGap();
    };

    const goToSlide = (index) => {
      const maxIndex = getMaxIndex();
      currentIndex = index < 0 ? maxIndex : index > maxIndex ? 0 : index;
      updateSlider();
    };

    const updateSlider = () => {
      const visibleSlides = getVisibleSlides();
      const maxIndex = getMaxIndex();
      currentIndex = Math.min(currentIndex, maxIndex);
      trackElement.style.transform = `translateX(-${currentIndex * getPageStride()}px)`;
      slideElements.forEach((slide, index) => {
        const firstVisibleIndex = stepBySlide ? currentIndex : currentIndex * visibleSlides;
        const isActive = index >= firstVisibleIndex && index < firstVisibleIndex + visibleSlides;
        slide.setAttribute('aria-hidden', String(!isActive));
        if (isActive) {
          slide.removeAttribute('inert');
        } else {
          slide.setAttribute('inert', '');
        }
      });
      const dots = dotsElement.querySelectorAll('.slider-dot');
      dots.forEach((dot, index) => {
        const shouldShow = index <= maxIndex;
        dot.classList.toggle('is-active', index === currentIndex);
        dot.toggleAttribute('hidden', !shouldShow);
        dot.setAttribute('aria-current', index === currentIndex ? 'true' : 'false');
      });
    };

    slideElements.forEach((_, index) => {
      const dot = document.createElement('button');
      dot.className = 'slider-dot';
      dot.type = 'button';
      dot.setAttribute('aria-label', `${dotLabel} ${index + 1}`);
      dot.addEventListener('click', () => goToSlide(index));
      dotsElement.append(dot);
    });

    previousControl?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextControl?.addEventListener('click', () => goToSlide(currentIndex + 1));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') goToSlide(currentIndex - 1);
      if (event.key === 'ArrowRight') goToSlide(currentIndex + 1);
    });

    root.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0]?.screenX ?? 0;
      },
      { passive: true },
    );

    root.addEventListener(
      'touchend',
      (event) => {
        const touchEndX = event.changedTouches[0]?.screenX ?? 0;
        const distance = touchStartX - touchEndX;
        if (Math.abs(distance) > 45) goToSlide(currentIndex + (distance > 0 ? 1 : -1));
      },
      { passive: true },
    );

    window.addEventListener('resize', updateSlider);

    updateSlider();
  };

  setupSlider({
    rootSelector: '[data-product-slider]',
    trackSelector: '[data-product-track]',
    slideSelector: '[data-product-slide]',
    dotsSelector: '[data-product-dots]',
    previousSelector: '[data-product-prev]',
    nextSelector: '[data-product-next]',
    dotLabel: 'Show product',
    desktopVisible: 3,
    stepBySlide: true,
  });

  setupSlider({
    rootSelector: '[data-review-slider]',
    trackSelector: '[data-review-track]',
    slideSelector: '[data-review-slide]',
    dotsSelector: '[data-review-dots]',
    previousSelector: '[data-review-prev]',
    nextSelector: '[data-review-next]',
    dotLabel: 'Show review',
  });

  document.querySelectorAll('[data-countdown]').forEach((countdown) => {
    const storageKey = 'astroLandingNewCustomerDiscountEndsAt';
    const durationHours = Number(countdown.getAttribute('data-duration-hours')) || 48;
    const durationMs = durationHours * 60 * 60 * 1000;
    const savedEndTime = Number(window.localStorage.getItem(storageKey));
    let endTime = savedEndTime > Date.now() ? savedEndTime : Date.now() + durationMs;

    window.localStorage.setItem(storageKey, String(endTime));

    const units = {
      days: countdown.querySelectorAll('[data-unit="days"] [data-digit]'),
      hours: countdown.querySelectorAll('[data-unit="hours"] [data-digit]'),
      minutes: countdown.querySelectorAll('[data-unit="minutes"] [data-digit]'),
      seconds: countdown.querySelectorAll('[data-unit="seconds"] [data-digit]'),
    };

    const initializeDigit = (digit, value) => {
      digit.classList.add('flip-digit');
      digit.innerHTML = `
        <span class="flip-digit__half flip-digit__base flip-digit__base-top"><span>${value}</span></span>
        <span class="flip-digit__half flip-digit__base flip-digit__base-bottom"><span>${value}</span></span>
        <span class="flip-digit__half flip-digit__flap flip-digit__flap-top"><span>${value}</span></span>
        <span class="flip-digit__half flip-digit__flap flip-digit__flap-bottom"><span>${value}</span></span>
      `;
      digit.dataset.value = value;
      digit.dataset.initialized = 'true';
    };

    const setDigitPanels = (digit, currentValue, nextValue) => {
      digit.querySelector('.flip-digit__base-top span').textContent = currentValue;
      digit.querySelector('.flip-digit__base-bottom span').textContent = currentValue;
      digit.querySelector('.flip-digit__flap-top span').textContent = currentValue;
      digit.querySelector('.flip-digit__flap-bottom span').textContent = nextValue;
    };

    const setDigits = (unit, value) => {
      const nextValue = String(value).padStart(2, '0').slice(-2);
      units[unit].forEach((digit, index) => {
        const nextDigit = nextValue[index];
        if (digit.dataset.initialized !== 'true') {
          initializeDigit(digit, nextDigit);
          return;
        }

        const currentDigit = digit.dataset.value;
        if (currentDigit === nextDigit || digit.classList.contains('is-flipping')) return;

        setDigitPanels(digit, currentDigit, nextDigit);
        digit.classList.remove('is-flipping');
        requestAnimationFrame(() => digit.classList.add('is-flipping'));
        window.setTimeout(() => {
          setDigitPanels(digit, nextDigit, nextDigit);
          digit.dataset.value = nextDigit;
          digit.classList.remove('is-flipping');
        }, 460);
      });
    };

    const tick = () => {
      if (Date.now() >= endTime) {
        endTime = Date.now() + durationMs;
        window.localStorage.setItem(storageKey, String(endTime));
      }

      const remaining = Math.max(0, endTime - Date.now());
      const totalSeconds = Math.floor(remaining / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      setDigits('days', days);
      setDigits('hours', hours);
      setDigits('minutes', minutes);
      setDigits('seconds', seconds);
    };

    tick();
    const intervalId = window.setInterval(tick, 1000);
    window.addEventListener('visibilitychange', tick);
    window.addEventListener('pageshow', tick);
    window.addEventListener('pagehide', () => window.clearInterval(intervalId), { once: true });
  });

  if (lightbox && lightboxImage instanceof HTMLImageElement) {
    const openLightbox = (src, alt) => {
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      lightbox.removeAttribute('hidden');
      document.body.classList.add('is-lightbox-open');
      lightboxClose?.focus();
    };

    const closeLightbox = () => {
      lightbox.setAttribute('hidden', '');
      lightboxImage.src = '';
      document.body.classList.remove('is-lightbox-open');
    };

    document.querySelectorAll('[data-lightbox-src]').forEach((button) => {
      button.addEventListener('click', () => {
        const src = button.getAttribute('data-lightbox-src');
        const alt = button.getAttribute('data-lightbox-alt') ?? 'Enlarged gallery image';
        if (src) openLightbox(src, alt);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hasAttribute('hidden')) closeLightbox();
    });
  }
</script>
