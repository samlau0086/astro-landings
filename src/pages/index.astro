const offers = [
  {
    title: 'Curated Everyday Essentials',
    description: 'Fast-moving products selected for repeat demand, clear margins, and easy merchandising.',
    icon: '✦',
  },
  {
    title: 'Wholesale-Ready Supply',
    description: 'Bulk ordering, predictable lead times, and flexible quantities for stores, teams, and resellers.',
    icon: '▦',
  },
  {
    title: 'Retail-Friendly Experience',
    description: 'Polished packaging, conversion-focused bundles, and support assets that make buying simple.',
    icon: '◈',
  },
];

const products = [
  {
    name: 'Starter Retail Bundle',
    price: 'From $149',
    tag: 'Best seller',
    description: 'A balanced mix of proven SKUs designed for first-time buyers and compact displays.',
  },
  {
    name: 'Wholesale Growth Pack',
    price: 'Custom quote',
    tag: 'Wholesale',
    description: 'Volume pricing, priority allocation, and replenishment support for growing operators.',
  },
  {
    name: 'Premium Gift Set',
    price: 'From $39',
    tag: 'Retail',
    description: 'Shelf-ready packaging with a premium unboxing experience for seasonal campaigns.',
  },
  {
    name: 'Display Counter Kit',
    price: 'From $89',
    tag: 'New',
    description: 'Compact merchandising kit designed for checkout counters and impulse-buy placement.',
  },
  {
    name: 'Seasonal Promo Pack',
    price: 'From $199',
    tag: 'Campaign',
    description: 'A campaign-ready assortment for holiday, gifting, and limited-time retail promotions.',
  },
  {
    name: 'Reorder Essentials Case',
    price: 'Custom quote',
    tag: 'Reorder',
    description: 'A replenishment-focused case for proven products with consistent weekly sell-through.',
  },
];

const reasons = [
  'Quality checked before dispatch',
  'Responsive support from order to delivery',
  'Low-friction reorder process',
  'Clear pricing with no hidden handling fees',
];

const steps = [
  ['01', 'Choose your mix', 'Select retail bundles, wholesale packs, or request a custom assortment.'],
  ['02', 'Confirm pricing', 'We align on quantity, packaging needs, delivery window, and final landed cost.'],
  ['03', 'Receive & sell', 'Orders ship in protective packaging with tracking and reorder support.'],
];

const reviews = [
  {
    quote: 'The products arrived ready to sell, and our reorder was even faster than the first shipment.',
    author: 'Maya L.',
    role: 'Boutique Owner',
    initials: 'ML',
    image: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=160&q=85',
    productImages: [
      {
        src: 'https://images.unsplash.com/photo-1607344645866-009c320f4c8e?auto=format&fit=crop&w=900&q=85',
        alt: 'Retail bundle packaging displayed on a counter',
      },
      {
        src: 'https://images.unsplash.com/photo-1585386959984-a41552231658?auto=format&fit=crop&w=900&q=85',
        alt: 'Premium product bottle close-up from customer review',
      },
      {
        src: 'https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=900&q=85',
        alt: 'Gift-ready product box photographed by customer',
      },
    ],
  },
  {
    quote: 'Great communication, clean packaging, and the wholesale pricing made the numbers work.',
    author: 'Daniel R.',
    role: 'Regional Buyer',
    initials: 'DR',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&q=85',
    productImages: [
      {
        src: 'https://images.unsplash.com/photo-1612817288484-6f916006741a?auto=format&fit=crop&w=900&q=85',
        alt: 'Wholesale product assortment ready for store merchandising',
      },
      {
        src: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=900&q=85',
        alt: 'Customer review image showing retail-ready packaging',
      },
      {
        src: 'https://images.unsplash.com/photo-1556228578-8c89e6adf883?auto=format&fit=crop&w=900&q=85',
        alt: 'Clean product lineup photographed after delivery',
      },
    ],
  },
  {
    quote: 'Our customers noticed the presentation immediately. The bundle format is easy to promote.',
    author: 'Sofia C.',
    role: 'Retail Manager',
    initials: 'SC',
    image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=85',
    productImages: [
      {
        src: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=85',
        alt: 'Shelf-ready products arranged for customer review',
      },
      {
        src: 'https://images.unsplash.com/photo-1627384113710-424c9181ebbe?auto=format&fit=crop&w=900&q=85',
        alt: 'Premium packaged item included in a customer review',
      },
      {
        src: 'https://images.unsplash.com/photo-1607006344380-b6775a0824ce?auto=format&fit=crop&w=900&q=85',
        alt: 'Unboxed product set photographed by a retail buyer',
      },
    ],
